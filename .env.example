# Server-side env. Loaded by docker-compose app/worker containers and host-side local wrappers.

# Docker compose runtime DATABASE_URL. This is for app/worker containers.
# Host-side local dev: just run `pnpm dev:local` and open http://127.0.0.1:8788/. It starts its
# own dev Postgres (docker-compose.dev.yml, 127.0.0.1:5434, loom_dev/loom_dev, own volume) and
# never reads this DATABASE_URL. Host-side scripts that DO read DATABASE_URL directly
# (db:generate/db:push/db:migrate via drizzle.config.ts, worker:dev, seed:*, db:backfill:*,
# db:recompute:*, and every CLI importing scripts/load-env.ts) share one TEST-target guard
# (scripts/local-db-env.ts): the union of the URL authority, comma-separated hosts,
# `?host=`/`?port=`, and PGHOST/PGPORT is checked — any loopback candidate on
# 5433/5544, or a loopback candidate whose database is `loom`, is refused before
# connecting. Production (NODE_ENV=production) skips this database check; that is
# an explicit switch, not a security boundary.
# The default for target-resolving scripts (dev:local, dev:reset, db:migrate:local) is
# always this worktree's dev database on :5434; the only local override is
# DEV_ALLOW_TEST_DB=1 (prints a warning; dev API+worker then write TEST data and take
# its jobs). Local dev also refuses 8787 (TEST app relay); production/container
# API_PORT=8787 is unaffected.
# Reset the dev DB: docker compose -f docker-compose.dev.yml --profile dev down -v
DATABASE_URL=postgres://loom:loom@postgres:5432/loom?sslmode=disable
# Postgres connections per API/worker process. Restart-only; unset uses 10.
DB_POOL_MAX=

# Product generative AI (API + worker + Mem0 extraction/reconciliation).
# Process pin overrides explicit chat model bindings and task/lane DB choices.
# AI_PROVIDER_OVERRIDE=opencode-go
# AI_PROVIDER_MODEL=deepseek-v4.1-flash
OPENCODE_API_KEY=
# Xiaomi official Token Plan alternative. Set the product pair above to the
# xiaomi-token-plan lane and its TEST-verified model in both app and worker.
# Token Plan tp- keys and XIAOMI_API_KEY are not interchangeable.
XIAOMI_TOKEN_PLAN_API_KEY=
# Region accepts cn, sgp, ams; unset defaults to cn.
XIAOMI_TOKEN_PLAN_REGION=
# Optional explicit OpenAI-compatible /v1 base URL overrides region.
XIAOMI_TOKEN_PLAN_BASE_URL=
# Legacy rollback/alternative credentials; no silent fallback under the pin.
ANTHROPIC_API_KEY=
XIAOMI_API_KEY=
# Native pi Z.AI Coding CN AI lane (OCR/memory keep ZHIPU_API_KEY separately).
ZAI_CODING_CN_API_KEY=

# OPENAI_API_KEY (YUK-1027) — enables the opt-in `openai` lane serving
# gpt-6-astra over the OpenAI Responses API via the pi builtin provider
# (https://api.openai.com/v1/responses). NOT required for the default setup:
# no production route/default uses it; it is consumed only when a task/test
# explicitly binds provider 'openai' (or AI_PROVIDER_OVERRIDE=openai +
# AI_PROVIDER_MODEL=gpt-6-astra is set for a targeted run). Leave empty for
# normal operation.
OPENAI_API_KEY=

# Cross-process admission for CENTRAL Claude Agent SDK query sessions (YUK-842).
# Default is `off`. maxConcurrentSessions caps active session-family branches;
# one same-lane nested descendant chain may share its root slot, while parallel
# branches consume more slots. Starts/min counts every session reservation. These
# settings are NOT raw open-query counts or wire-request RPM limits.
# Roll out the same policy to every app/worker process in `observe` first, then
# quiesce and switch them together to `enforce`; see
# /Volumes/YukovalSBak/yukoval-projects/tlp-docs/repo-docs/docs/runbooks/provider-session-admission.md.
# AI_PROVIDER_SESSION_ADMISSION_MODE=off
# AI_PROVIDER_SESSION_ADMISSION_POLICIES_JSON={"opencode-go":{"maxConcurrentSessions":4,"maxSessionStartsPerMinute":30,"maxQueuedSessions":32,"maxWaitMs":30000}}

# Operator `pnpm preflight:vision` overrides only; product vision uses the
# resolved vision-judge task lane. Under the xiaomi-token-plan pin, the probe
# uses XIAOMI_TOKEN_PLAN_API_KEY and derives /anthropic from the lane /v1 URL;
# its model defaults to AI_PROVIDER_MODEL or the lane's mimo-v2.6-pro evidence.
# Explicit MIMO_VISION_BASE_URL must match the selected credential lane; its
# host must pass the models.dev model-endpoint allowlist (YUK-1654), and under
# the Token Plan pin only token-plan-<region>.xiaomimimo.com is accepted.
# These variables do not reroute product vision/OCR.
MIMO_VISION_BASE_URL=
MIMO_VISION_MODEL=

# Mem0 extraction/reconciliation shares the product pair above, including
# OpenCode's session header. MEM0_LLM_* cannot bypass the global pin.
# Dedicated embeddings retain DashScope text-embedding-v4 and existing dimensions.
# No standalone Mem0 service: app reads, worker writes the mounted history volume.
DASHSCOPE_API_KEY=

# Mem0 optional overrides (defaults live in src/server/ai/mem0/client.ts). Leave
# these COMMENTED OUT to use the defaults — a bare `KEY=` sets the var to "" (not
# unset), and createMem0Config treats empty-after-trim as "use the default", so
# either form is safe; commented-out just keeps the template honest. Uncomment +
# set a value only to override.
#   MEM0_LLM_MODEL=             # explicit legacy GLM lane only; absent overrides inherit DEFAULT_TASK_MODEL
#   MEM0_LLM_BASE_URL=          # explicit legacy GLM endpoint; requires ZHIPU_API_KEY and an allowlisted host
#   MEM0_EMBEDDING_MODEL=         # default text-embedding-v4 (阿里百炼 DashScope); also used by the domain embedder
#   MEM0_EMBEDDING_BASE_URL=     # default https://dashscope.aliyuncs.com/compatible-mode/v1 (has /v1); host must pass the model-endpoint allowlist (YUK-1654)
#   MEM0_EMBEDDING_DIMS=         # default 1024 (embedder dims + pgvector column MUST match; positive int)
#   MEM0_PGVECTOR_COLLECTION=   # default learning_project_memories
#   MEM0_PGVECTOR_HNSW=         # default false (set "true" to enable HNSW on the pgvector store)
#   MEM0_PGVECTOR_DISKANN=     # default false (set "true" to enable DiskANN; mutually exclusive with HNSW)

# mem0 history (SQLite sidecar, disableHistory:false) — feeds the extraction
# prompt's "Last k Messages" (the sole benefit of keeping history on). The
# native better-sqlite3 module backs it (Dockerfile sqlitedeps overlay).
#   MEM0_HISTORY_DB_PATH: code default is /var/lib/mem0/history.db (absolute, to
#     dodge the relative-to-cwd multi-process footgun). Local dev (copy this file
#     → .env yourself; `pnpm dev:local` loads an existing .env, it does not create it)
#     can't write /var/lib, so point it at a repo-relative, gitignored path. PROD
#     does NOT use this value — the compose
#     app/worker services set MEM0_HISTORY_DB_PATH explicitly (worker → the
#     mem0data volume, app → /tmp ephemeral) and force MEM0_TELEMETRY=false.
MEM0_HISTORY_DB_PATH=./.mem0/history.db
# mem0 phones PostHog on every add/search/update/delete unless this is exactly
# "false". Off here for local dev too; compose re-asserts it for prod.
MEM0_TELEMETRY=false

# Internal auth (`server/app.ts` gates /api/* on this; /api/health exempt).
INTERNAL_TOKEN=

# YUK-589 — server-ONLY HMAC secret for judge preview provenance tokens
# (src/server/judge/preview-provenance-token.ts). MUST differ from INTERNAL_TOKEN
# and MUST NEVER be exposed to any client/browser surface: it is the sole thing
# stopping a caller from forging `supplied_verified` judge provenance. Generate
# with `openssl rand -hex 32`. Values shorter than 32 characters are treated as
# UNSET. When UNSET the judge advice endpoint issues no provenance token and
# submit paths treat any supplied judge result as
# `supplied_unverified` (fail-closed) — set it in prod to enable verified
# provenance. This is app-only; the worker never signs/verifies these tokens.
JUDGE_PROVENANCE_SECRET=

# YUK-1448 — server-ONLY HMAC secret for bank gap evidence MACs
# (src/capabilities/practice/question-bank/tools/bank-search.ts). search_bank signs every
# coverage.gap_request with it; file_bank_gap verifies the MAC before any paid
# supply dispatch, so a caller cannot fabricate gap evidence (e.g. complete:true).
# MUST differ from INTERNAL_TOKEN and MUST NEVER be exposed to any client/browser
# surface. Generate with `openssl rand -hex 32`. Values shorter than 32 characters
# are treated as UNSET. When UNSET, gap_requests carry no evidence_mac and
# file_bank_gap rejects every filing (fail-closed) — set it in prod to enable
# bank-gap filing. app and worker must read the SAME value. `pnpm dev:local`
# derives a stable per-worktree value when this is unset (dev database only;
# never with DEV_ALLOW_TEST_DB=1).
BANK_GAP_EVIDENCE_SECRET=

# Cloudflare R2 (S3-compatible) — Sub 0b1
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_BUCKET=

# GLM-OCR (YUK-253) — DEFAULT extraction OCR engine (Zhipu GLM-OCR
# layout_parsing). Replaces Tencent as the character-level text + layout source;
# the VLM StructureTask still owns the structure tree (ADR-0002 / YUK-145).
# Source: open.bigmodel.cn console. REQUIRED on the default path — with
# EXTRACT_OCR_ENGINE unset/'glm', a missing key fails every extraction permanent.
# Billable: 0.2 元/M tokens (input=output), logged to cost_ledger (provider 'glm').
# Engine selector / rollback flag. 'glm' (default, unset == glm) | 'tencent'
# (retained as the permanent rollback path). Set to 'tencent' to fall
# back to the Tencent QuestionMarkAgent engine (requires the TENCENT_* keys below).
# EXTRACT_OCR_ENGINE=glm
ZHIPU_API_KEY=

# Tencent OCR (used by ingestion). Sub 0c may add QuestionSplitOCR keys.
# PHASE-DEFERRED (YUK-253): retained as the EXTRACT_OCR_ENGINE='tencent' rollback
# engine. Keep set during the GLM bake-in window so the fallback stays available.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OCR_REGION=ap-shanghai

# YUK-258 — DOCX ingestion converter seam
# (src/capabilities/ingestion/server/docx/convert.ts).
#
#   !!! NOT an on/off feature gate. !!!  The docx upload endpoint is always
#   available; this var only overrides which converter binary the seam uses.
#
# UNSET (default): the seam probes `which pandoc` / `which soffice`. In the prod
# runner image these are apt-installed (Dockerfile) so binaries are used directly.
# Set to EXACTLY "docker" to FORCE the docker-run fallback (pandoc/core +
# linuxserver/libreoffice images) — useful in local dev where the host has no
# pandoc/soffice on PATH and you'd rather not install them. Any other value is
# ignored (= unset behaviour).
DOCX_CONVERT_ENGINE=

# Cloudflare Tunnel (Sub 0z) — runs cloudflared in the docker-compose stack.
# Generate via Zero Trust dashboard → Networks → Tunnels → Create tunnel.
TUNNEL_TOKEN=
# "auto" prefers QUIC and falls back to HTTP/2. Set "http2" when the Docker
# host blocks outbound UDP/7844 (for example, the current OrbStack deployment).
TUNNEL_PROTOCOL=auto

# YUK-1529 — worksheet_render job 打开的打印页 origin（仅 worker 读）。
# docker-compose.yml 已在 worker 服务显式设 http://app:8787；此项覆盖之或供
# 本机 `pnpm worker:dev` 单独使用（缺省 http://localhost:8787；`pnpm dev:local` 自己把它设为
# http://127.0.0.1:${DEV_PORT:-8788}，页面与 /api 同源）。
WORKSHEET_RENDER_APP_ORIGIN=

# 本机 `pnpm dev:local`：页面与 /api 同源在 http://127.0.0.1:${DEV_PORT:-8788}/。DEV_PORT 缺省 8788，
# 避开 TEST app 容器占用的 8787；显式 DEV_PORT=8787 会在绑定前退出（8787 是本机 TEST 中继端口）。
# dev-local 把它作为 API_PORT 传给 API，并让 dev worker 渲染到同一端口。
# DEV_PORT=8788
# DEV_PORT 与 DEV_ALLOW_TEST_DB 只由本机 dev wrapper（scripts/dev-local.ts、
# scripts/local-db-env.ts）读取，不在 boot schema；容器/managed 环境不要设。
# 页面由 API 进程内的 Vite dev server 提供，保存页面组件即热更新（HMR），无需构建。
# RW_FRONTDOOR 由 dev:local 设为 dev；生产镜像设为 1（built dist/start），本文件无需设置。

# Postgres credentials for docker-compose (only used by the postgres service +
# the db:dump / db:restore scripts; the app reads DATABASE_URL above directly).
# These are the TEST/production stack's values. Local dev: `pnpm dev:local` and
# `pnpm dev:reset` ignore them entirely (their target is always the worktree dev
# database on :5434). The target-resolving scripts read POSTGRES_DB as the
# database selector — POSTGRES_DB=loom (TEST's name) resolves to a refused target
# unless DEV_ALLOW_TEST_DB=1 — and read POSTGRES_USER/POSTGRES_PASSWORD only under
# that same switch (db:dump / db:restore pass them to docker compose separately).
POSTGRES_USER=loom
POSTGRES_PASSWORD=loom
POSTGRES_DB=loom
# Direct/opaque provider-attempt admission. Missing config and unlisted lanes are OFF.
# Keep the same values in the API app and pg-boss worker environments.
AI_PROVIDER_ATTEMPT_ADMISSION_MODE=off
AI_PROVIDER_ATTEMPT_ADMISSION_POLICIES_JSON={}

# Optional application task/model/tool traces (YUK-1325). Empty means no SDK import/export.
# Set the same project key in the API and worker environments; never commit a real key.
# Metadata by default. Capability-owned per-run laminarContent may add sanitized summaries.
LMNR_PROJECT_API_KEY=
# Owner-authorized development transcripts only; also requires NODE_ENV=development.
# Start: NODE_ENV=development LMNR_DEV_TRANSCRIPTS=1 pnpm dev:local
# Production/test/unset NODE_ENV ignore this switch, even when set to 1.
LMNR_DEV_TRANSCRIPTS=0
# Whitelisted task transcripts in any environment, not tied to NODE_ENV: only tasks whose
# content holds no learner material. Everything else stays metadata only. Only `1` enables.
LMNR_TRANSCRIPTS=0
# Tags every span tlp-env=<value> so environments sharing a project can be filtered. Default dev.
LMNR_TRACE_ENV=dev

# ─── boot schema 其余键（src/core/config/server/env.ts）────────────────────
# 每个键的归属（boot / secret / test / script / hot）写在该文件的 BOOT_ENV_OWNERS，
# 新变量该放哪张表的判断见 src/core/config/AGENTS.md。这里不写真实值；未设即用
# registry codeDefault，当前生效值与来源看 /admin/config。
# 空串不等于未设：多数键的 envParse 把 '' 当未表达（效果同未设），但个别键
# `KEY=` 是真值（如 ''=显式关闭、''→NaN 直通），这些键只留注释样例。
# *_ENABLED 统一语法：true/1 = 开，false/0 = 关（大小写不敏感，忽略首尾空格）；
# 不设保持该开关的默认。

# hot：已登记 CONFIG_REGISTRY；DB 行为主，env 只作 fallback/pin（15s 快照生效）。
AI_RATE_LIMIT_MAX=
AI_RATE_LIMIT_WINDOW_MS=
AUTO_INTERVENTION_EXPANSION_ENABLED=
BACKUP_IMPORT_MAX_BYTES=
CLAUDE_CODE_MAX_RETRIES=
COPILOT_NUDGE_DAILY_MAX=
COPILOT_NUDGE_EXPIRES_HOURS=
COPILOT_SUBAGENT_ENABLED=
HUB_SYNC_MODE=
INTERVENTION_DISABLED_METHOD_IDS=
JUDGE_CALIBRATION_BATCH_MAX=
JUDGE_CALIBRATION_REJUDGE_MODEL=
JUDGE_CALIBRATION_REJUDGE_PROVIDER=
JUDGE_CALIBRATION_SAMPLING_ENABLED=
JUDGE_CALIBRATION_WINDOW_DAYS=
JUDGE_DURABLE_ENABLED=
# JUDGE_FALLBACK_PROVIDER=   # '' = 显式关闭跨 provider 判分兜底；不设 = codeDefault
JYEOO_BACKFILL_TIMEOUT_MS=
JYEOO_DAILY_FETCH_BUDGET=
JYEOO_RS_BINARY=
# JYEOO_SPAWN_MAX_STDERR_BYTES=  # '' 解析成 NaN → spawn fail-closed；不设 = codeDefault
# JYEOO_SPAWN_MAX_STDOUT_BYTES=  # '' 解析成 NaN → spawn fail-closed；不设 = codeDefault
# JYEOO_SPAWN_TIMEOUT_MS=        # '' 解析成 NaN → spawn fail-closed；不设 = codeDefault
KC_DEDUP_DISTANCE_MAX=
KC_DEDUP_MAX_PAIRS=
KC_DEDUP_WINDOW_DAYS=
LEARNING_DAY_INACTIVITY_GAP_HOURS=
MISCONCEPTION_PROMOTE_ENABLED=
PLACEMENT_PROBE_ENABLED=
PROJECTION_IS_WRITER_ITEM_CALIBRATION=
PROPOSAL_AUTO_APPLY_ENABLED=
# QUESTION_ADMISSION_POLICY_ID=        # explicit policy must be non-empty; unset = codeDefault
# QUESTION_ADMISSION_SOLVER2_MODEL=    # optional per-field solver B override
# QUESTION_ADMISSION_SOLVER2_PROVIDER= # optional per-field solver B override
QUESTION_SUPPLY_REFILL_ENABLED=
SELECTION_POLICY=
TAGGING_MATCH_THRESHOLD=
VERIFY_SOLVE_MODEL_OVERRIDE=
VERIFY_SOLVE_PROVIDER_OVERRIDE=
VISION_JUDGE_MODEL=
VISION_JUDGE_PROVIDER=
WAVE6_TRIGGER_DREAMING_ENABLED=
WAVE6_TRIGGER_MARK_WRONG_ENABLED=
WAVE6_TRIGGER_MASTERY_ENABLED=
WORKFLOW_JUDGE_STUDENT_ANSWER_GRADING_ENABLED=

# secret：凭据/HMAC；不写 system_config，也不下发浏览器。
ANTHROPIC_AUTH_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
EXA_API_KEY=
OPENROUTER_API_KEY=
VERCEL_AI_GATEWAY_TOKEN=

# boot：产品代码在启动/适配器初始化/作业边界读解析后的 env；无 DB 层。
ANTHROPIC_BASE_URL=
RW_BOSS_AUTOMATION=
RW_FRONTDOOR=
RW_WORKER=
LMNR_DEBUG=
LMNR_SPAN_CONTEXT=
LMNR_TRACE_METADATA=
# 进程环境自带，通常不写进 .env：
# HOME=
# PATH=
# TMPDIR=
# NODE_ENV=

# test：只由测试/CI/本机 dev 读取。
# DOCKER_HOST=            # rehearsal ephemeral-pg
# LOCAL_POSTGRES_HOST=    # dev:local 的 dev Postgres
# LOCAL_POSTGRES_PORT=
# LOCAL_NEXT_PORT=        # dev 前端端口
# VITEST=                 # vitest 进程标记

# script：只由 scripts/CLI/部署工具读，API 与 worker 不读。
# API_SMOKE_BASE_URL=       # pnpm api:smoke
# AUDIT_READ_DATABASE_URL=  # report-only 审计的只读库
# B3_GATE_CONFIRM_CLONE=  # b3 闸门
# DELIVERY_API_BASE=      # delivery:e2e
# DELIVERY_API_PORT=
# LOOM_PG_IMAGE=          # cutover-backup 的 pgvector 镜像
# PROFILE_CRITIC_OK=      # 本地生成器人工放行位
# SEED_SYNTHETIC_OK=
