{
  "permissions": {
    "deny": [
      "mcp__codebase-memory__search_code",
      "mcp__codebase-memory__search_graph",
      "mcp__codebase-memory__get_code_snippet",
      "mcp__codebase-memory__get_architecture",
      "mcp__codebase-memory__manage_adr",
      "mcp__codebase-memory__ingest_traces",
      "mcp__codebase-memory__detect_changes",
      "mcp__codebase-memory__delete_project",
      "mcp__codebase-memory__list_projects",
      "mcp__codebase-memory__index_status"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/json-edit-guard.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/git-guard.mjs"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/linear-guard.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -z \"$f\" ] && exit 0; case \"$f\" in *.json) jq . \"$f\" >/dev/null 2>&1 || echo 'JSON invalid: '\"$f\" >&2 ;; *.ts|*.tsx|*.js|*.jsx|*.mjs) pnpm exec biome check --no-errors-on-unmatched \"$f\" 2>&1 | head -40 ;; esac"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-fetch-divergence.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/linear-closeout-reminder.sh"
          }
        ]
      }
    ]
  }
}
