# YUK-916 Buildkite Green Bridge - Phase 1 pins.
# Verified 2026-08-25 via `git ls-remote` + tag checkout of the plugin source.
# The previously claimed pin (v0.6.0 @ a8ea2f2c4af84794a4f18c93b1dc78bcbb252337)
# does not exist upstream (GitHub API 422, absent from all refs); v0.13.0 is the
# release whose `workflows:` shape the Phase 0 shadow pipeline actually ran.
# Freshness gate: scripts/ci/verify-build-context.mjs --pins fails when
# GITHUB_ACTIONS_PLUGIN_OBSERVED_AT is older than PIN_MAX_AGE_DAYS.
GITHUB_ACTIONS_PLUGIN_SOURCE=buildkite-plugins/github-actions-buildkite-plugin
GITHUB_ACTIONS_PLUGIN_RELEASE=v0.13.0
GITHUB_ACTIONS_PLUGIN_COMMIT=98159d5e696d06b70df490b9d7d9eabc32bc2b21
GITHUB_ACTIONS_PLUGIN_OBSERVED_AT=2026-08-25
NODE_VERSION=24.0.0
PNPM_VERSION=11.13.1
BUN_VERSION=1.3.14
PIN_MAX_AGE_DAYS=30

# YUK-917 runner lane: custom CI image for the linux-large queue.
# Base digest resolved 2026-08-25 from MCR via
# `docker buildx imagetools inspect mcr.microsoft.com/playwright:v1.62.1-noble`
# (amd64 manifest; the tag matches the repo's @playwright/test 1.62.1 pin).
# The final agent image digest DOES NOT EXIST YET: it is only created when the
# lead runs .github/workflows/buildkite-ci-image.yml. While
# CI_IMAGE_STATE=image_digest_pending_publication the pins gate forbids
# CI_IMAGE_DIGEST, the usability manifest keeps cutover_ready=false, and no
# required/cutover use is allowed. After publication, record CI_IMAGE_DIGEST
# (sha256:<64 hex> from the workflow's digest artifact) and
# CI_IMAGE_PUBLISHED_AT, and flip the state to image_digest_published.
CI_IMAGE_REPO=ghcr.io/yukoval-dakia/the-learning-project/buildkite-ci
CI_IMAGE_BASE_REF=mcr.microsoft.com/playwright:v1.62.1-noble
CI_IMAGE_BASE_DIGEST=sha256:c091b21d9fae78c76e85cd4356431e9b018402f172a214fc7d7a5e9a7e29d8ac
CI_IMAGE_PLAYWRIGHT_VERSION=1.62.1
CI_IMAGE_STATE=image_digest_pending_publication
