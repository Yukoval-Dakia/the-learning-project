digraph ArchitectureComparison {
  rankdir=LR;
  bgcolor="transparent";
  node [fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=8];

  // The Learning Project
  subgraph cluster_tlp {
    label="The Learning Project\n(Learning Platform)";
    style=filled;
    fillcolor="#e3f2fd";
    
    TLP_Client [label="Vite SPA\nReact 19", shape=box, style=filled, fillcolor="#bbdefb"];
    TLP_API [label="Hono API\n:8787", shape=box, style=filled, fillcolor="#90caf9"];
    TLP_Worker [label="pg-boss Worker\nBackground Jobs", shape=box, style=filled, fillcolor="#90caf9"];
    TLP_Tasks [label="51 TaskSpecs\nTyped AI Tasks", shape=box, style=filled, fillcolor="#64b5f6"];
    TLP_Tools [label="DomainTool Registry\nMCP Bridge", shape=box, style=filled, fillcolor="#64b5f6"];
    TLP_DB [label="PostgreSQL\nEvent Sourcing", shape=cylinder, style=filled, fillcolor="#42a5f5"];
    TLP_Providers [label="MiMo / Anthropic", shape=ellipse, style=filled, fillcolor="#1e88e5"];
    
    TLP_Client -> TLP_API;
    TLP_API -> TLP_Tasks;
    TLP_Worker -> TLP_Tasks;
    TLP_Tasks -> TLP_Tools;
    TLP_Tasks -> TLP_Providers;
    TLP_API -> TLP_DB;
    TLP_Worker -> TLP_DB;
  }

  // OpenCode
  subgraph cluster_opencode {
    label="OpenCode\n(AI Coding Assistant)";
    style=filled;
    fillcolor="#fff3e0";
    
    OC_Client [label="TUI / Desktop", shape=box, style=filled, fillcolor="#ffcc80"];
    OC_Server [label="OpenCode Server\nHTTP API", shape=box, style=filled, fillcolor="#ffb74d"];
    OC_Plugins [label="Plugin System\nWorktree/MCP/Custom", shape=box, style=filled, fillcolor="#ffa726"];
    OC_Sessions [label="Session Manager\nSQLite", shape=cylinder, style=filled, fillcolor="#ff9800"];
    OC_Providers [label="Claude / OpenAI / Local", shape=ellipse, style=filled, fillcolor="#fb8c00"];
    
    OC_Client -> OC_Server;
    OC_Server -> OC_Plugins;
    OC_Server -> OC_Providers;
    OC_Server -> OC_Sessions;
  }

  // Comparison annotations
  subgraph cluster_comparison {
    label="Key Differences";
    style=filled;
    fillcolor="#f5f5f5";
    
    Diff1 [label="Task-based vs Session-based", shape=note, style=filled, fillcolor="#eeeeee"];
    Diff2 [label="pg-boss vs In-process", shape=note, style=filled, fillcolor="#eeeeee"];
    Diff3 [label="PostgreSQL vs SQLite", shape=note, style=filled, fillcolor="#eeeeee"];
    Diff4 [label="DomainTool vs Plugin Tool", shape=note, style=filled, fillcolor="#eeeeee"];
    Diff5 [label="Event Sourcing vs State", shape=note, style=filled, fillcolor="#eeeeee"];
  }

  // Cross-references
  TLP_Tasks -> Diff1 [style=dashed, arrowhead=none];
  OC_Server -> Diff1 [style=dashed, arrowhead=none];
  
  TLP_Worker -> Diff2 [style=dashed, arrowhead=none];
  OC_Server -> Diff2 [style=dashed, arrowhead=none];
  
  TLP_DB -> Diff3 [style=dashed, arrowhead=none];
  OC_Sessions -> Diff3 [style=dashed, arrowhead=none];
  
  TLP_Tools -> Diff4 [style=dashed, arrowhead=none];
  OC_Plugins -> Diff4 [style=dashed, arrowhead=none];
  
  TLP_DB -> Diff5 [style=dashed, arrowhead=none];
  OC_Sessions -> Diff5 [style=dashed, arrowhead=none];
}
